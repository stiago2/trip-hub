# Database
DATABASE_URL="postgresql://user:password@host:5432/triphub?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://your-backend.railway.app/api/auth/google/callback"
# Mobile OAuth — same client ID/secret, different callback URL registered in Google Console
GOOGLE_MOBILE_CALLBACK_URL="https://your-backend.railway.app/api/auth/google/mobile/callback"
# Custom URL scheme for mobile deep links (matches capacitor.config.ts appId prefix)
MOBILE_SCHEME="triphub"

# Frontend / Mobile
FRONTEND_URL="http://localhost:4200"

# App
PORT=3000
